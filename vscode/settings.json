{
  "telemetry.telemetryLevel": "off",
  "json.format.keepLines": true,
  "chat.agent.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "files.exclude": {
    "**/.DS_Store": false,
    "**/Thumbs.db": false
  },
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.editor.wrapTabs": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromCodeNavigation": false,
  "multiDiffEditor.experimental.enabled": false,
  "workbench.editor.splitInGroupLayout": "vertical",
  "files.autoSave": "afterDelay",
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.enhancedColorization": "Enabled",
  "terminal.integrated.tabs.defaultColor": "terminal.ansiWhite",
  "workbench.iconTheme": "nokiaics-file-icons",
  "workbench.editor.empty.hint": "hidden",
  "editor.fontFamily": "'Meslo LG S DZ', 'Dejavu Sans Mono', monospace",
  "editor.wordWrapColumn": 120,
  "editor.wordWrap": "on",
  "editor.tabSize": 4,
  "editor.detectIndentation": true,
  "editor.mouseWheelZoom": true,
  "editor.bracketPairColorization.enabled": false,
  "editor.formatOnPaste": true,
  "editor.minimap.autohide": "scroll",
  "editor.rulers": [
    {
      "column": 80,
      "color": "#101f31",
      "length": 1
    },
    {
      "column": 120,
      "color": "#0b2c55"
    }
  ],
  "editor.lineHeight": 23.6,
  "editor.fontSize": 15.5,
  "terminal.integrated.fontFamily": "'Pragmasevka', 'JetBrains Mono', monospace",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyleInactive": "none",
